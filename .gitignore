# Virtual environments
.venv/
venv/
.uv-python/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Data (download separately). Manifests under data/manifests/ are tracked;
# everything downloaded into data/<name>/ is ignored so loaders (GEARS et al.)
# can treat data/<name>/ as a pure download cache.
data/**
!data/
!data/.gitkeep
!data/*.sh
!data/manifests/
!data/manifests/*.yaml
cache

# Model artifacts (downloaded via setup scripts)
_artifacts/
models/*/checkpoints/

# Inference outputs and cell-eval results
predictions/
eval_outputs/

# wandb run logs
wandb/

# Papers: keep markdown, ignore the source PDFs (may have copyright)
docs/papers/*.pdf

# IDE
.vscode/
.idea/

# Claude Code local session state
.claude/

# Personal planning notes (local only)
plans/

# OS
.DS_Store
